# StoryQuest Studio — local secrets (NEVER commit this file; .gitignore covers .env*)
# Copy .env.example to .env and fill in your Google Cloud Desktop OAuth credentials.
# Google Cloud Console > APIs & Services > Credentials > Create Credentials > OAuth client ID > Desktop app
# Enable in the same project: YouTube Data API v3 + YouTube Analytics API.
# Scopes requested: youtube.readonly + yt-analytics.readonly + yt-analytics-monetary.readonly

GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=
# Optional: pre-selects this Google account in the OAuth chooser (your channel owner email)
GOOGLE_YOUTUBE_LOGIN_HINT=

# Optional: override data dir (default: app local data dir / ./StoryQuestProjects)
# STORYQUEST_DATA_DIR=
